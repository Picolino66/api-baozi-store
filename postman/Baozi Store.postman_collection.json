{
  "info": {
    "name": "Baozi Store",
    "description": "Execute os três POSTs primeiro. Os IDs são salvos automaticamente; depois execute GETs e DELETEs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Criar cliente",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/clientes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "clientes"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Isaías Gonçalves Ribeiro5145055\",\n  \"clienteDesde\": \"2026-10-12\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) pm.collectionVariables.set(\"clienteId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Criar produto",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/produtos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "produtos"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Baozi de porco\",\n  \"preco\": 12.5,\n  \"estoque\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) pm.collectionVariables.set(\"produtoId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Criar pedido",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/pedidos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "pedidos"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clienteId\": {{clienteId}},\n  \"produtoId\": {{produtoId}},\n  \"quantidade\": 3\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) pm.collectionVariables.set(\"pedidoId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
